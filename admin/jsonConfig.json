{
  "i18n": true,
  "type": "tabs",
  "items": {
    "connection": {
      "type": "panel",
      "label": "Verbindung",
      "items": {
        "_info1": {
          "type": "staticText",
          "text": "Trage nur die IP-Adresse deines Cerbo GX / Venus OS / GX-Geräts und den Modbus-TCP-Port ein. Auf dem GX-Gerät muss Modbus TCP aktiviert sein.",
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "host": {
          "type": "text",
          "label": "GX IP-Adresse / Hostname",
          "help": "Beispiel: 192.168.50.91 - keine Leerzeichen eingeben",
          "validator": "!!data.host && !/\\s/.test(data.host)",
          "xs": 12,
          "sm": 6,
          "md": 6,
          "lg": 6,
          "xl": 6
        },
        "port": {
          "type": "port",
          "label": "Modbus TCP Port",
          "min": 1,
          "max": 65535,
          "xs": 12,
          "sm": 6,
          "md": 3,
          "lg": 3,
          "xl": 3
        },
        "timeout": {
          "type": "number",
          "label": "Timeout je Anfrage (ms)",
          "min": 500,
          "max": 30000,
          "xs": 12,
          "sm": 6,
          "md": 3,
          "lg": 3,
          "xl": 3
        },
        "unitIdSystem": {
          "type": "number",
          "label": "System Unit-ID",
          "help": "Für com.victronenergy.system normalerweise 100.",
          "min": 0,
          "max": 255,
          "xs": 12,
          "sm": 6,
          "md": 3,
          "lg": 3,
          "xl": 3
        },
        "pollInterval": {
          "type": "number",
          "label": "Abfrageintervall (ms)",
          "help": "Für die Lovelace-Liveansicht sind 1000 bis 2000 ms sinnvoll. Höhere Werte wirken sichtbar träge.",
          "min": 1000,
          "max": 600000,
          "xs": 12,
          "sm": 6,
          "md": 3,
          "lg": 3,
          "xl": 3
        }
      },
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "scan": {
      "type": "panel",
      "label": "Automatische Suche",
      "items": {
        "enableDeviceScan": {
          "type": "checkbox",
          "label": "Angeschlossene Victron-Dienste automatisch suchen",
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "scanUnitIds": {
          "type": "text",
          "label": "Unit-IDs für Suche",
          "help": "Kommagetrennt eintragen, z. B. 100,223,224,225,226,227,228,229,230,245,246,247. Die System-Unit-ID und Steuer-Unit-ID werden zusätzlich automatisch berücksichtigt.",
          "validator": "!!data.scanUnitIds && /^\\s*\\d{1,3}(\\s*,\\s*\\d{1,3})*\\s*$/.test(data.scanUnitIds)",
          "hidden": "!data.enableDeviceScan",
          "xs": 12,
          "sm": 8,
          "md": 8,
          "lg": 8,
          "xl": 8
        },
        "scanInterval": {
          "type": "number",
          "label": "Suchintervall (ms)",
          "min": 60000,
          "max": 3600000,
          "hidden": "!data.enableDeviceScan",
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 4,
          "xl": 4
        },
        "_scanHelp": {
          "type": "staticText",
          "text": "Hinweis: Die echten Unit-IDs siehst du am GX-Gerät unter Einstellungen → Integrationen/Services → Modbus TCP → Verfügbare Dienste. Die Suche versucht bekannte Registerbereiche automatisch zu erkennen.",
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        }
      },
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "statistics": {
      "type": "panel",
      "label": "Statistik & Prognose",
      "items": {
        "_statInfo": {
          "type": "staticText",
          "text": "Der Adapter summiert PV-Ertrag, Verbrauch, Netzbezug, Einspeisung, Akku und Wallbox selbst auf (statistics.*): heute, Monat, Jahr, Tagesverlauf und Historie der letzten 400 Tage. Die Werte bleiben bei einem Neustart erhalten.",
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "priceImport": {
          "type": "number",
          "label": "Strompreis Bezug (€/kWh)",
          "min": 0,
          "max": 5,
          "step": 0.01,
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 4,
          "xl": 4
        },
        "priceExport": {
          "type": "number",
          "label": "Einspeisevergütung (€/kWh)",
          "min": 0,
          "max": 5,
          "step": 0.001,
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 4,
          "xl": 4
        },
        "batteryCapacityKwh": {
          "type": "number",
          "label": "Nutzbare Akkukapazität (kWh)",
          "help": "Für „Akku voll in“. 0 = Wert aus Dynamic ESS verwenden.",
          "min": 0,
          "max": 1000,
          "step": 0.1,
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 4,
          "xl": 4
        },
        "forecastTodayStateId": {
          "type": "objectId",
          "label": "Datenpunkt PV-Prognose heute",
          "help": "Optional, z. B. aus dem pvforecast- oder Solcast-Adapter",
          "xs": 12,
          "sm": 8,
          "md": 8,
          "lg": 8,
          "xl": 8
        },
        "forecastUnit": {
          "type": "select",
          "label": "Einheit der Prognose",
          "options": [
            {
              "label": "kWh",
              "value": "kWh"
            },
            {
              "label": "Wh",
              "value": "Wh"
            }
          ],
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 4,
          "xl": 4
        },
        "_vrmHeader": {
          "type": "header",
          "text": "Historie aus dem VRM-Portal",
          "size": 5,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "_vrmInfo": {
          "type": "staticText",
          "text": "Der GX liefert über Modbus keine Historie. Mit einem VRM-Zugriffstoken importiert der Adapter die Tageswerte (PV, Verbrauch, Netz, Akku) der letzten 400 Tage aus dem VRM-Portal und aktualisiert sie alle 3 Stunden. Token erstellen: VRM-Portal → Einstellungen → Integrationen → Zugriffstoken. Die Installations-ID steht in der VRM-Adresse: vrm.victronenergy.com/installation/<ID>/…",
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "vrmEnabled": {
          "type": "checkbox",
          "label": "Historie aus VRM importieren",
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "vrmSiteId": {
          "type": "text",
          "label": "VRM-Installations-ID",
          "hidden": "!data.vrmEnabled",
          "validator": "!data.vrmEnabled || /^\\d+$/.test(data.vrmSiteId || '')",
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 4,
          "xl": 4
        },
        "vrmToken": {
          "type": "password",
          "label": "VRM-Zugriffstoken",
          "hidden": "!data.vrmEnabled",
          "repeat": false,
          "visible": true,
          "xs": 12,
          "sm": 8,
          "md": 8,
          "lg": 8,
          "xl": 8
        }
      },
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "lovelace": {
      "type": "panel",
      "label": "Lovelace Karte",
      "items": {
        "_lovelaceInfo": {
          "type": "staticText",
          "text": "Optional: Kopiert die Victron-Energieflusskarte und drei YAML-Beispiele in den Dateispeicher der Lovelace-Instanz und gibt die Dashboard-Datenpunkte für Lovelace frei. Nach dem ersten Kopieren bzw. nach einem Kartenupdate die Lovelace-Instanz einmal neu starten.",
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "installLovelaceCard": {
          "type": "checkbox",
          "label": "Lovelace-Integration aktivieren (Karte installieren und Datenpunkte freigeben)",
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "lovelaceInstance": {
          "type": "text",
          "label": "Lovelace Instanz",
          "help": "Normalerweise lovelace.0",
          "hidden": "!data.installLovelaceCard",
          "xs": 12,
          "sm": 6,
          "md": 6,
          "lg": 6,
          "xl": 6
        }
      },
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "control": {
      "type": "panel",
      "label": "Steuerung",
      "items": {
        "_warn": {
          "type": "staticText",
          "text": "Schreiben ist aus Sicherheitsgründen standardmäßig deaktiviert. Ist es aktiviert, sind alle beschreibbaren Datenpunkte (controls.*, Relais unter system.*, beschreibbare Geräteregister unter devices.* und eigene Register) aktiv. Erst aktivieren, wenn du die Wirkung auf deine Anlage verstanden hast.",
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "allowWrites": {
          "type": "checkbox",
          "label": "Schreib-/Steuerbefehle erlauben",
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "controlUnitId": {
          "type": "number",
          "label": "Steuer Unit-ID",
          "help": "Für ESS Mode 2 normalerweise 100. Für VE.Bus Mode 3 kann je nach GX-Gerät eine VE.Bus Unit-ID nötig sein.",
          "min": 0,
          "max": 255,
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 4,
          "xl": 4
        },
        "useNewSetpoint": {
          "type": "checkbox",
          "label": "Neuen 32-Bit Grid-Setpoint 2716/2717 verwenden",
          "xs": 12,
          "sm": 8,
          "md": 8,
          "lg": 8,
          "xl": 8
        },
        "legacySetpointEnabled": {
          "type": "checkbox",
          "label": "Legacy Grid-Setpoint 2700 zusätzlich anlegen",
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "writeSafetyMinW": {
          "type": "number",
          "label": "Minimal erlaubter Setpoint (W)",
          "min": -1000000,
          "max": 0,
          "xs": 12,
          "sm": 6,
          "md": 6,
          "lg": 6,
          "xl": 6,
          "help": "Gilt für alle beschreibbaren Datenpunkte mit der Einheit W."
        },
        "writeSafetyMaxW": {
          "type": "number",
          "label": "Maximal erlaubter Setpoint (W)",
          "min": 0,
          "max": 1000000,
          "xs": 12,
          "sm": 6,
          "md": 6,
          "lg": 6,
          "xl": 6,
          "help": "Gilt für alle beschreibbaren Datenpunkte mit der Einheit W."
        }
      },
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "custom": {
      "type": "panel",
      "label": "Eigene Register",
      "items": {
        "_customInfo": {
          "type": "staticText",
          "text": "Hier kannst du zusätzliche Victron-Register anlegen, die der Adapter nicht von selbst kennt. Sie erscheinen unter custom.unit_<Unit-ID>_reg_<Adresse>, werden bei jeder Abfrage gelesen und sind – wenn „beschreibbar“ gesetzt und Schreiben erlaubt ist – auch schreibbar. Adresse, Typ und Faktor bitte der Victron-Registerliste entnehmen. Faktor = Multiplikator nach dem Lesen (Victron-Skalierung 10 → Faktor 0.1).",
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "customRegisters": {
          "type": "table",
          "noDelete": false,
          "items": [
            {
              "type": "checkbox",
              "attr": "enabled",
              "title": "Aktiv",
              "width": "6%",
              "default": true
            },
            {
              "type": "text",
              "attr": "name",
              "title": "Name",
              "width": "24%",
              "default": ""
            },
            {
              "type": "number",
              "attr": "unitId",
              "title": "Unit-ID",
              "width": "10%",
              "min": 0,
              "max": 255,
              "default": 100
            },
            {
              "type": "number",
              "attr": "address",
              "title": "Adresse",
              "width": "12%",
              "min": 0,
              "max": 65535,
              "default": 0
            },
            {
              "type": "select",
              "attr": "type",
              "title": "Typ",
              "width": "12%",
              "options": [
                {
                  "label": "uint16",
                  "value": "uint16"
                },
                {
                  "label": "int16",
                  "value": "int16"
                },
                {
                  "label": "uint32",
                  "value": "uint32"
                },
                {
                  "label": "int32",
                  "value": "int32"
                }
              ],
              "default": "uint16"
            },
            {
              "type": "number",
              "attr": "scale",
              "title": "Faktor",
              "width": "10%",
              "default": 1
            },
            {
              "type": "text",
              "attr": "unit",
              "title": "Einheit",
              "width": "10%",
              "default": ""
            },
            {
              "type": "checkbox",
              "attr": "writable",
              "title": "Beschreibbar",
              "width": "10%",
              "default": false
            }
          ],
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        }
      },
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    }
  }
}
